<!DOCTYPE html>
<html class="h-full bg-slate-50">
<head>
  <title>Subscriber | Stay Notified</title>

  <%= csrf_meta_tags %>

  <%= stylesheet_link_tag "index", media: "all" %>
  <%= javascript_include_tag "index" %>
</head>

<body class="h-full font-sans antialiased text-slate-900">

  <!-- Header / Navigation -->
  <header class="bg-white border-b border-slate-200">
    <div class="max-w-6xl px-4 mx-auto sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center gap-2">
          <!-- Notification Bell Icon Logo -->
          <svg class="w-6 h-6 text-blue-600 animate-pulse" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
          </svg>
          <span class="text-xl font-bold tracking-tight text-slate-900">subscriber<span class="text-blue-600">.</span></span>
        </div>
        <nav class="flex items-center gap-6">
          <a href="#features" class="text-sm font-medium transition text-slate-500 hover:text-slate-900">Features</a>
          
        </nav>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <main>
    <div class="relative overflow-hidden">
      <!-- Gradient Background Flare -->
      <div class="absolute inset-x-0 bottom-0 top-[-10%] -z-10 transform-gpu overflow-hidden blur-3xl" aria-hidden="true">
        <div class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/12 rotate-[30deg] bg-gradient-to-tr from-blue-200 to-indigo-400 opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.187rem]"></div>
      </div>

      <div class="max-w-4xl px-4 py-20 mx-auto text-center sm:px-6 lg:px-8 sm:py-28">
        <!-- Live Demo Badge -->
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-ping"></span>
          Live Push Demo
        </span>

        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl">
          Never miss an important <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">update again.</span>
        </h1>
        
        <p class="max-w-xl mx-auto mt-6 text-lg leading-8 text-slate-600">
          Experience instant, secure desktop and mobile notifications. Click below to test our real-time Web Push delivery system.
        </p>

        <!-- Subscription Action Box -->
        <div class="max-w-md mx-auto p-6 mt-10 bg-white border border-slate-200 rounded-2xl shadow-xl shadow-slate-100">
          <div class="flex flex-col items-center gap-4">
            <div class="p-3 bg-blue-50 rounded-full text-blue-600">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z" />
              </svg>
            </div>
            
            <div class="text-center">
              <h2 class="text-base font-semibold text-slate-900">Enable Push Notifications</h2>
              <p class="mt-1 text-sm text-slate-500">You can unsubscribe at any time from your browser settings.</p>
            </div>

            <!-- Hooked directly to your existing JavaScript main() function -->
            <button onclick="main()" class="w-full inline-flex justify-center items-center justify-center rounded-xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition duration-150 active:scale-[0.98]">
              Subscribe Now
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Features Grid Section -->
    <div id="features" class="py-16 bg-white border-t border-slate-100">
      <div class="max-w-5xl px-4 mx-auto sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
          
          <!-- Feature 1 -->
          <div class="flex flex-col items-center text-center p-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 mb-4">
              ⚡
            </div>
            <h3 class="text-sm font-semibold text-slate-900">Sub-Second Delivery</h3>
            <p class="mt-2 text-xs text-slate-500 leading-relaxed">Notifications are processed and routed globally instantly through secure VAPID protocols.</p>
          </div>

          <!-- Feature 2 -->
          <div class="flex flex-col items-center text-center p-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 mb-4">
              📱
            </div>
            <h3 class="text-sm font-semibold text-slate-900">Cross-Platform Support</h3>
            <p class="mt-2 text-xs text-slate-500 leading-relaxed">Fully compatible with all standard modern desktop engines and mobile WebKit architectures.</p>
          </div>

          <!-- Feature 3 -->
          <div class="flex flex-col items-center text-center p-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 mb-4">
              🔒
            </div>
            <h3 class="text-sm font-semibold text-slate-900">Privacy First</h3>
            <p class="mt-2 text-xs text-slate-500 leading-relaxed">No personal information required. Receive alerts safely without sharing your email or phone number.</p>
          </div>

        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-slate-50 border-t border-slate-200 py-6">
    <div class="max-w-6xl px-4 mx-auto text-center text-xs text-slate-400">
      &copy; <%= Time.current.year %> Subscriber. Powered safely by Ruby on Rails.
    </div>
  </footer>

</body>
</html>
