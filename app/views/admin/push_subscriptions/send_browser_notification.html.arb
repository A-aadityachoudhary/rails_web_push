h2 "Send Notification to #{@browser} Users"

active_admin_form_for :notification,
                      url: send_browser_notification_submit_admin_push_subscriptions_path,
                      method: :post do |f|
                      
  f.inputs "Notification Details" do
    # Crucial: set value: @browser explicitly inside input_html
    f.input :browser,
        as: :hidden,
        input_html: { value: params[:browser] }

    f.input :title
    f.input :body, as: :text, input_html: { rows: 4 }
    f.input :icon, label: "Icon URL", input_html: { placeholder: "https://example.com/icon.png" }
    f.input :image, label: "Image URL", input_html: { placeholder: "https://example.com/banner.jpg" }
    f.input :action_title, label: "Button Text", input_html: { placeholder: "Open Website" }
    f.input :action_url, label: "Button Link", input_html: { placeholder: "https://example.com" }
  end

  f.actions do
    f.action :submit, label: "Send to #{@browser} Users"
    f.cancel_link(admin_push_subscriptions_path)
  end
end