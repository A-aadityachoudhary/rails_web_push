active_admin_form_for :notification,
                      url: send_notification_all_submit_admin_push_subscriptions_path,
                      method: :post do |f|

  f.inputs do
    f.input :title
    f.input :body, as: :text
  end

  f.actions do
    f.action :submit, label: "Send Notification to All"
  end

end